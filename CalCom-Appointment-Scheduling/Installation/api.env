# FILE LOCATION: /home/user/docker/calcom/apps/api/v2/.env
# Create a new file since there is only an example that currently exists
# Paste the contents of this document into the newly created .env file.
# MAKE SURE THIS IS ONLY AN `.env` FILE AND NOT `api.env`

NODE_ENV=production
API_PORT=3000
API_URL=https://${WEB_APP_URL}/api/v2
DATABASE_READ_URL=
DATABASE_WRITE_URL=
LOG_LEVEL=log
NEXTAUTH_SECRET=0BTFdtG8UOEemV53WZj/VYfd5Wa3NhuA4E2sclSpoFk=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}/${POSTGRES_DB}
JWT_
SENTRY_DSN=

# KEEP THIS EMPTY, DISABLE SENTRY CLIENT INSIDE OF LIBRARIES USED BY APIv2
NEXT_PUBLIC_SENTRY_DSN=

# Stripe Billing
# STRIPE_PRICE_ID_STARTER=
# STRIPE_PRICE_ID_STARTER_OVERAGE=
# STRIPE_PRICE_ID_ESSENTIALS=
# STRIPE_PRICE_ID_ESSENTIALS_OVERAGE=
# STRIPE_PRICE_ID_ENTERPRISE=
# STRIPE_PRICE_ID_ENTERPRISE_OVERAGE=
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

WEB_APP_URL=https://YOUR.CALCOM.DOMAIN
CALCOM_LICENSE_KEY=FILL-OUT-KEY-HERE
API_KEY_PREFIX=cal_
GET_LICENSE_KEY_URL="https://console.cal.com/api/license"
IS_E2E=false
DOCS_URL=

# Axiom logging
AXIOM_DATASET=
AXIOM_TOKEN=

# DEBUG: 0
# INFO: 1
# WARN: 2
# ERROR: 3
LOGGER_BRIDGE_LOG_LEVEL="1"

