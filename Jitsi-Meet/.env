# shellcheck disable=SC2034

################################################################################
# Jitsi Meet Docker Configuration
#
# This file contains all environment variables for configuring your Jitsi Meet instance.
# For detailed documentation, please refer to:
# https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker
################################################################################

####################################
### Basic Configuration
####################################

CONFIG=/home/ubuntu/jitsi-meet/.jitsi-meet-cfg
TZ=America/Los_Angeles
HTTP_PORT=8001
HTTPS_PORT=8443
PUBLIC_URL=http://192.168.25.87:${HTTP_PORT}
# PUBLIC_URL=https://meet.lazymedia.media
RELEASE_VERSION=stable-10184
JVB_ADVERTISE_IPS=192.168.25.87
JIGASI_PORT_MIN=20000
JIGASI_PORT_MAX=20050

####################################
### Network and Port Configuration
####################################

JVB_PORT=10001
JVB_COLIBRI_PORT=8080
COLIBRI_WEBSOCKET_PORT=9090
COLIBRI_WEBSOCKET_JVB_LOOKUP_NAME=jvb
COLIBRI_WEBSOCKET_REGEX=^[a-zA-Z0-9]+$
# ENABLE_COLIBRI_WEBSOCKET_UNSAFE_REGEX=[a-zA-Z0-9-\._]+
# COLIBRI_WEBSOCKET_JVB_LOOKUP_NAME=COLIBRI_WEBSOCKET_REGEX
# DISABLE_COLIBRI_WEBSOCKET_JVB_LOOKUP=
AUTOSCALER_URL=${PUBLIC_URL}
# ENABLE_HSTS=1
# ENABLE_IPV6=0

