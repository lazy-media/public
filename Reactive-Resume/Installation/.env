##### Change any settings in this file to update the docker-compose.yaml file with appropriate settings.
##### Most variables are transferred to this .env file from the original compose file.
##### I personally prefer to use a .env file instead of having values in the compose file.

#############################################
##### RESTART POLICY FOR ALL CONTAINERS #####
#############################################

RESTART_POLICY=unless-stopped


#############################
##### POSTGRES SETTINGS #####
#############################

POSTGRES_DIR=./postgres_data
POSTGRES_IMAGE=postgres
POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

####################################
##### MINIO / STORAGE SETTINGS #####
####################################

MINIO_DIR=./minio_data
MINIO_IMAGE=minio/minio
MINIO_IMAGE_TAG=latest
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

###########################
##### CHROME SETTINGS #####
###########################

CHROME_IMAGE=ghcr.io/browserless/chromium
CHROME_IMAGE_TAG=v2.18.0 # Upgrading to newer versions causes issues
CHROME_TOKEN=chrome_token

#############################
##### MAIN APP SETTINGS #####
#############################

## -- APP Image and Tag Settings -- ##
APP_IMAGE=amruthpillai/reactive-resume
APP_IMAGE_TAG=latest

## -- ENVIRONMENT VARIABLES -- ##
NODE_ENV=production
APP_PORT=3000

### Set public url to your local ip address or FQDN
PUBLIC_URL=http://[your-server-ip]:3000
STORAGE_URL=http://[your-server-ip]:9000/default

## -- Printer (CHROME) SETTINGS -- ##
CHROME_URL=ws://chrome:3000

## -- AUTH -- ##
ACCESS_TOKEN_SECRET=access_token
REFRESH_TOKEN_SECRET=refresh_token

## -- EMAILS -- ##
## Optional but recommended if you want new users to confirm email
## address before new signups, or for use with password resets.
MAIL_FROM=no-reply@your.domain
SMTP_USER=user@your.domain
SMTP_PASS=emailpassword
SMTP_ADDR=smtp.gmail.com
SMTP_PORT=587

## -- STORAGE (MINIO) -- ##
STORAGE_ENDPOINT=minio
STORAGE_PORT=9000
STORAGE_REGION=us-east-1 # Optional
STORAGE_BUCKET=default
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL="false"
STORAGE_SKIP_BUCKET_CHECK="false"

## -- CROWDIN (Optional) -- ##
CROWDIN_PROJECT_ID=
CROWDIN_PERSONAL_TOKEN=

## -- LOGIN PAGE (Optional) -- ##
DISABLE_SIGNUPS="false"
DISABLE_EMAIL_AUTH="false"

## -- GITHUB OAUTH (Optional) -- ##
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

## -- GOOGLE OAUTH (Optional) -- ##
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

## -- OPENID (Optional) -- ##
VITE_OPENID_NAME=OpenID
OPENID_AUTHORIZATION_URL=http://localhost:3000/api/auth/openid/callback
OPENID_ISSUER=
OPENID_TOKEN_URL=
OPENID_USER_INFO_URL=
OPENID_CALLBACK_URL=http://localhost:3000/api/auth/openid/callback
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SCOPE= openid profile email